@model Practical_8_.Net.Models.InventoryItem

@{
    ViewBag.Title = "Delete Product";
}

<h2 style="color: red;">Delete Confirmation</h2>
<p>Are you sure you want to permanently delete this product from the database?</p>

<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>Product ID</dt>
        <dd>#@Model.ProductId</dd>

        <dt>Product Name</dt>
        <dd>@Model.ProductName</dd>

        <dt>Quantity</dt>
        <dd>@Model.Quantity</dd>

        <dt>Price</dt>
        <dd>@Model.Price.ToString("C")</dd>
    </dl>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Yes, Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}